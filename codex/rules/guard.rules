# Codex execpolicy guardrails (Pendant zum Claude guard.py)
prefix_rule(pattern=["git", "push", "--force"], decision="prompt", justification="Force-Push nur nach Rückfrage")
prefix_rule(pattern=["git", "push", "-f"], decision="prompt", justification="Force-Push nur nach Rückfrage")
prefix_rule(pattern=["git", "reset", "--hard"], decision="prompt", justification="verwirft Änderungen")
prefix_rule(pattern=["git", "clean", "-fd"], decision="prompt", justification="löscht untracked Files")
prefix_rule(pattern=["docker", "compose", "down", "-v"], decision="prompt", justification="löscht Volumes")
prefix_rule(pattern=["docker", "system", "prune"], decision="prompt", justification="löscht Docker-Daten")
prefix_rule(pattern=["rm", "-rf", "/"], decision="forbidden", justification="nope")
prefix_rule(pattern=["rm", "-rf", "~"], decision="forbidden", justification="nope")
